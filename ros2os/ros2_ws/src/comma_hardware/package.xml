<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>comma_hardware</name>
  <version>0.1.0</version>
  <description>Device health node for comma devices: thermal zones and fan control, power draw, car-battery protection, resource usage, network state, driver-camera IR LEDs and display power.</description>
  <maintainer email="noreply@example.com">ros2os maintainers</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>comma_msgs</exec_depend>
  <exec_depend>comma_hal</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
