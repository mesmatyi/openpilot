<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>comma_gnss</name>
  <version>0.1.0</version>
  <description>ROS 2 GNSS driver for comma devices: u-blox receiver (UBX NAV-PVT over /dev/ttyHS0) or the Quectel modem's GNSS engine (NMEA over USB).</description>
  <maintainer email="noreply@example.com">ros2os maintainers</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>nmea_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>comma_hal</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
