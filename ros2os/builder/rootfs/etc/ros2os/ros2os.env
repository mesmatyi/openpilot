# ros2os environment, read by every ros2os service and login shell.
# Override any value in /data/ros2os/ros2os.env (persists across image updates).
ROS_DISTRO=@ROS_DISTRO@
ROS_DOMAIN_ID=0
# rmw_fastrtps_cpp (default), rmw_cyclonedds_cpp or rmw_zenoh_cpp (needs `ros2 run rmw_zenoh_cpp rmw_zenohd`)
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# SUBNET: discoverable on the local network; LOCALHOST: device only
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROS_LOG_DIR=/tmp/ros2os/log
RCUTILS_COLORIZED_OUTPUT=0
# extra arguments for `ros2 launch comma_bringup comma.launch.py`, e.g. "audio:=false foxglove:=false"
ROS2OS_LAUNCH_ARGS=
# restart the drivers (at most every 10 min) when a network interface comes up, so DDS advertises it
ROS2OS_RESTART_ON_NETWORK=1
# topics recorded by ros2os-record.service (space separated; empty = built-in list)
ROS2OS_RECORD_TOPICS=
ROS2OS_RECORD_DIR=/data/media/ros2_bags
# ros2os-deleter keeps at least this much of /data free by removing the oldest recordings
ROS2OS_MIN_FREE_PERCENT=10
